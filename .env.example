# External MySQL connection
DB_HOST=
DB_PORT=3306
DB_NAME=auth_system
DB_USER=
DB_PASS=
# Set to required for providers that require TLS; use disabled only when supported.
DB_SSL=required
# Optional PEM paths if your provider requires a specific CA certificate.
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=

# Aiven Redis connection. Predis uses tls:// for TLS providers.
REDIS_SCHEME=tls
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB Atlas connection
MONGO_URI=
MONGO_DB_NAME=auth_system
MONGO_COLLECTION=profiles

# Optional local-development cookie override; leave unset on Render.
COOKIE_SECURE=
COOKIE_SAMESITE=Lax